
#!/bin/bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

# Create a non-root administration user.
useradd -m -s /bin/bash devops
echo 'devops ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/90-devops
chmod 440 /etc/sudoers.d/90-devops

# Install and enable Docker and UFW.
apt-get update
apt-get install -y docker.io ufw
systemctl enable --now docker

# Configure host firewall.
ufw default deny incoming
ufw default allow outgoing
ufw allow from '${ssh_cidr}' to any port 22 proto tcp
ufw allow ${app_port}/tcp
ufw --force enable

# Reconstruct the original application files.
mkdir -p /opt/intern-task-app/app

echo '${dockerfile_b64}' | base64 -d > /opt/intern-task-app/Dockerfile
echo '${app_b64}' | base64 -d > /opt/intern-task-app/app/app.py

# Build the actual application image.
docker build -t intern-task-app:local /opt/intern-task-app

# Register the container as a systemd service.
cat > /etc/systemd/system/intern-task-app.service <<'EOF'
[Unit]
Description=Atomity Intern Task Python Application
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=simple
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f intern-task-app
ExecStart=/usr/bin/docker run --rm --name intern-task-app --network host intern-task-app:local
ExecStop=/usr/bin/docker stop intern-task-app

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now intern-task-app.service
