#!/bin/bash
set -euxo pipefail

if command -v dnf >/dev/null 2>&1; then
  package_manager=dnf
else
  package_manager=yum
fi

"$package_manager" update -y
if command -v amazon-linux-extras >/dev/null 2>&1; then
  amazon-linux-extras install docker -y
else
  "$package_manager" install -y docker
fi
"$package_manager" install -y firewalld git

if ! id intern >/dev/null 2>&1; then
  useradd --create-home --shell /bin/bash intern
fi
usermod --append --groups wheel intern
cat > /etc/sudoers.d/intern <<'SUDOERS'
intern ALL=(ALL) NOPASSWD: ALL
SUDOERS
chmod 0440 /etc/sudoers.d/intern

systemctl enable --now docker
systemctl enable --now firewalld
firewall-cmd --set-default-zone=public
firewall-cmd --zone=public --set-target=DROP
for service in $(firewall-cmd --zone=public --list-services); do
  firewall-cmd --zone=public --remove-service="$service" --permanent
done
for port in $(firewall-cmd --zone=public --list-ports); do
  firewall-cmd --zone=public --remove-port="$port" --permanent
done
firewall-cmd --zone=public --add-port=${app_port}/tcp --permanent
firewall-cmd --reload

rm -rf /opt/devops-challenge
git clone --depth 1 --branch "${git_branch}" \
  "${git_repo_url}" /opt/devops-challenge

cd /opt/devops-challenge/intern-task-app

docker build -t intern-task-app:local .

cat > /etc/systemd/system/intern-task-app.service <<SERVICE
[Unit]
Description=Atomity Intern Task Application
Requires=docker.service
After=docker.service

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f intern-task-app
ExecStart=/usr/bin/docker run --rm --name intern-task-app -p ${app_port}:5000 intern-task-app:local
ExecStop=/usr/bin/docker stop --time 10 intern-task-app

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable --now intern-task-app.service