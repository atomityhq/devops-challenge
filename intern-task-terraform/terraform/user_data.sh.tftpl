#!/bin/bash
# Bootstrap for the intern-task-app instance.
# cloud-init runs this once, as root, on the first boot.
set -euo pipefail

APP_PORT=${app_port}
APP_DIR=/opt/intern-task-app
ADMIN_USER=appadmin

# 1. Non-root user with passwordless sudo.
# The sudoers rule is checked with visudo before it is installed,
# so a broken rule can never lock sudo.
useradd --create-home --shell /bin/bash "$ADMIN_USER"
echo "$ADMIN_USER ALL=(ALL) NOPASSWD:ALL" > /tmp/90-appadmin
visudo -cf /tmp/90-appadmin
install -m 0440 /tmp/90-appadmin /etc/sudoers.d/90-appadmin
rm -f /tmp/90-appadmin

# 2. Docker and the host firewall tool, from Ubuntu's own packages.
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io ufw curl
systemctl enable --now docker

# 3. The app source, byte for byte from the repo, built the same way
# as in intern-task-app: docker build -t intern-task-app:local .
mkdir -p "$APP_DIR/app"
echo '${dockerfile_b64}' | base64 -d > "$APP_DIR/Dockerfile"
echo '${app_py_b64}' | base64 -d > "$APP_DIR/app/app.py"
docker build -t intern-task-app:local "$APP_DIR"

# 4. Host firewall: deny all incoming traffic, allow only the app port.
ufw default deny incoming
ufw default allow outgoing
ufw allow "$APP_PORT/tcp"
ufw --force enable

# 5. Run the container as a systemd service that starts on every boot.
# --network host: the app listens on the host's own port, so ufw decides
# who can reach it. A published port (-p) would add Docker rules that
# bypass ufw.
cat > /etc/systemd/system/intern-task-app.service <<'UNIT'
[Unit]
Description=intern-task-app container
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
ExecStartPre=-/usr/bin/docker rm -f intern-task-app
ExecStart=/usr/bin/docker run --rm --name intern-task-app --network host intern-task-app:local
ExecStop=/usr/bin/docker stop intern-task-app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now intern-task-app.service

# 6. Check the service is really serving before calling the bootstrap done.
for _ in $(seq 1 30); do
  if curl -fsS "http://127.0.0.1:$APP_PORT/healthz"; then
    echo "intern-task-app is healthy on port $APP_PORT"
    exit 0
  fi
  sleep 2
done

echo "intern-task-app did not become healthy on port $APP_PORT" >&2
systemctl status intern-task-app.service --no-pager >&2 || true
exit 1