#!/bin/bash
set -euxo pipefail

export DEBIAN_FRONTEND=noninteractive

# Install Docker and the host firewall.
apt-get update
apt-get install -y docker.io ufw

systemctl enable --now docker

# Create a non-root administrator with passwordless sudo.
if ! id appadmin >/dev/null 2>&1; then
  useradd --create-home --shell /bin/bash appadmin
fi

usermod -aG sudo,docker appadmin
printf 'appadmin ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/appadmin
chmod 0440 /etc/sudoers.d/appadmin
visudo -cf /etc/sudoers.d/appadmin

# Install the real application source and Dockerfile.
# The Dockerfile expects app/app.py relative to the build context.
install -d -m 0755 /opt/intern-task-app/app

printf '%s' '${app_py_b64}' | base64 -d > /opt/intern-task-app/app/app.py
printf '%s' '${dockerfile_b64}' | base64 -d > /opt/intern-task-app/Dockerfile

chmod 0644 /opt/intern-task-app/app/app.py /opt/intern-task-app/Dockerfile

# Build and run the actual application through systemd.
cat > /etc/systemd/system/intern-task-app.service <<'UNIT'
[Unit]
Description=Intern Task App Docker Container
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f intern-task-app
ExecStartPre=/usr/bin/docker build -t intern-task-app:local /opt/intern-task-app
ExecStart=/usr/bin/docker run --rm --name intern-task-app -p 5000:5000 -e PORT=5000 intern-task-app:local
ExecStop=/usr/bin/docker stop -t 10 intern-task-app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now intern-task-app.service

# Restrict inbound traffic at the host firewall.
ufw default deny incoming
ufw default allow outgoing
ufw allow from '${ssh_cidr}' to any port 22 proto tcp
ufw allow 5000/tcp
ufw --force enable
