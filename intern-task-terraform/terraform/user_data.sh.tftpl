#!/bin/bash
set -euxo pipefail

# Create a non-root user with passwordless sudo
id appuser || useradd --create-home --shell /bin/bash appuser
usermod -aG docker appuser 2>/dev/null || true

echo "appuser ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/appuser
chmod 0440 /etc/sudoers.d/appuser
visudo -cf /etc/sudoers.d/appuser

# Install Docker and the host firewall
apt-get update
apt-get install -y docker.io ufw

systemctl enable --now docker

# Copy the actual app source and Dockerfile onto the instance
mkdir -p /opt/intern-task-app/app

echo '${app_source_b64}' | base64 -d > /opt/intern-task-app/app/app.py
echo '${dockerfile_b64}' | base64 -d > /opt/intern-task-app/Dockerfile

# Build the same Docker image used in the app task
docker build -t intern-task-app:local /opt/intern-task-app

# Configure the host firewall
ufw default deny incoming
ufw default allow outgoing
ufw allow from ${ssh_cidr} to any port 22 proto tcp
ufw allow ${app_port}/tcp
ufw --force enable

# Create a systemd service to manage the application container
cat > /etc/systemd/system/intern-task-app.service <<EOF
[Unit]
Description=Intern Task Application Container
Requires=docker.service
After=docker.service

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f intern-task-app
ExecStart=/usr/bin/docker run --name intern-task-app -p ${app_port}:${app_port} intern-task-app:local
ExecStop=/usr/bin/docker stop intern-task-app

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now intern-task-app.service
