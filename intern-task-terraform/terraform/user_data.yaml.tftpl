#cloud-config
package_update: true
packages:
  - docker.io
  - ufw
  - curl

users:
  - name: ${admin_user}
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - "${ssh_public_key}"

write_files:
  - path: /opt/intern-task-app/Dockerfile
    encoding: b64
    content: ${dockerfile_b64}
  - path: /opt/intern-task-app/app/app.py
    encoding: b64
    content: ${app_py_b64}
  - path: /etc/systemd/system/intern-task-app.service
    permissions: "0644"
    content: |
      [Unit]
      Description=intern-task-app container
      After=docker.service network-online.target
      Requires=docker.service

      [Service]
      Restart=always
      RestartSec=3
      ExecStartPre=-/usr/bin/docker rm -f intern-task-app
      ExecStart=/usr/bin/docker run --rm --name intern-task-app -p ${app_port}:${app_port} -e PORT=${app_port} intern-task-app:local
      ExecStop=/usr/bin/docker stop intern-task-app

      [Install]
      WantedBy=multi-user.target


runcmd:
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow 22/tcp
  - ufw allow ${app_port}/tcp
  - ufw --force enable
  - systemctl enable --now docker
  - docker build -t intern-task-app:local /opt/intern-task-app
  - systemctl daemon-reload
  - systemctl enable --now intern-task-app.service
  - curl -sf --retry 15 --retry-delay 2 --retry-connrefused http://127.0.0.1:${app_port}/healthz