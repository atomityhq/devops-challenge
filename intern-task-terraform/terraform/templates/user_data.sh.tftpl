#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

ADMIN_USER="${admin_user}"
APP_PORT="${app_port}"
SSH_ALLOWED_CIDR="${ssh_allowed_cidr}"
APP_DIR="/opt/intern-task-app"

# Install Docker and UFW
apt-get update
apt-get install -y --no-install-recommends ca-certificates docker.io ufw

systemctl enable --now docker

# Create non-root user with passwordless sudo and docker group membership
if ! id -u "$${ADMIN_USER}" >/dev/null 2>&1; then
  useradd --create-home --shell /bin/bash --groups sudo,docker "$${ADMIN_USER}"
else
  usermod --append --groups sudo,docker "$${ADMIN_USER}"
fi

echo "$${ADMIN_USER} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/$${ADMIN_USER}"
chmod 0440 "/etc/sudoers.d/$${ADMIN_USER}"
visudo -cf "/etc/sudoers.d/$${ADMIN_USER}"

# Write the real intern-task-app Dockerfile and source onto the host
mkdir -p "$${APP_DIR}/app"
base64 -d <<'EOF' > "$${APP_DIR}/Dockerfile"
${dockerfile_b64}
EOF
base64 -d <<'EOF' > "$${APP_DIR}/app/app.py"
${app_py_b64}
EOF
chown -R "$${ADMIN_USER}:$${ADMIN_USER}" "$${APP_DIR}"

# Build the container image from intern-task-app's Dockerfile
docker build -t intern-task-app:local "$${APP_DIR}"

# Run the container as a systemd service so it starts now and survives reboots
cat <<EOF > /etc/systemd/system/intern-task-app.service
[Unit]
Description=intern-task-app Docker container
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f intern-task-app
ExecStart=/usr/bin/docker run --rm --name intern-task-app -p $${APP_PORT}:$${APP_PORT} -e PORT=$${APP_PORT} intern-task-app:local
ExecStop=/usr/bin/docker stop -t 10 intern-task-app

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now intern-task-app.service

# Configure host firewall: deny incoming by default, allow app port and admin SSH CIDR
ufw --force reset
ufw default deny incoming
ufw default allow outgoing
ufw allow from "$${SSH_ALLOWED_CIDR}" to any port 22 proto tcp
ufw allow "$${APP_PORT}/tcp"
ufw --force enable
