#!/bin/bash
set -euxo pipefail

# Install required packages.
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y docker.io ufw sudo ca-certificates

# Enable Docker.
systemctl enable docker
systemctl start docker

# Create a dedicated administrator account.
if ! id internadmin >/dev/null 2>&1; then
    useradd --create-home --shell /bin/bash internadmin
fi

usermod -aG sudo,docker internadmin

cat > /etc/sudoers.d/internadmin <<'SUDOERS'
internadmin ALL=(ALL) NOPASSWD:ALL
SUDOERS

chmod 0440 /etc/sudoers.d/internadmin
visudo -cf /etc/sudoers.d/internadmin

# Reconstruct the real Part One application.
mkdir -p /opt/intern-task-app/app

printf '%s' '${dockerfile_b64}' | base64 -d \
    > /opt/intern-task-app/Dockerfile

printf '%s' '${app_source_b64}' | base64 -d \
    > /opt/intern-task-app/app/app.py

chmod 0644 /opt/intern-task-app/Dockerfile
chmod 0644 /opt/intern-task-app/app/app.py

# Build the actual application image.
docker build \
    --tag intern-task-app:local \
    /opt/intern-task-app

# Configure the host firewall.
ufw --force reset
ufw default deny incoming
ufw default allow outgoing

ufw allow from ${ssh_cidr} to any port 22 proto tcp
ufw allow ${app_port}/tcp

ufw --force enable

# Configure the application environment.
cat > /etc/default/intern-task-app <<'ENV'
PORT=${app_port}
ENV

chmod 0644 /etc/default/intern-task-app

# Create a systemd-managed application container.
cat > /etc/systemd/system/intern-task-app.service <<'UNIT'
[Unit]
Description=Intern Task Application Container
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/default/intern-task-app
ExecStartPre=-/usr/bin/docker rm -f intern-task-app
ExecStart=/usr/bin/docker run --name intern-task-app --network host --env PORT intern-task-app:local
ExecStop=/usr/bin/docker stop --time 10 intern-task-app
ExecStopPost=-/usr/bin/docker rm -f intern-task-app
Restart=always
RestartSec=5
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
UNIT

# Enable and start the application.
systemctl daemon-reload
systemctl enable intern-task-app.service
systemctl start intern-task-app.service

echo "Intern Task application bootstrap completed."
